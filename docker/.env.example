# ============================================================
# VigilIA — Variables de Entorno
#
# INSTRUCCIONES:
#   1. Copia este archivo como .env en la carpeta docker/
#   2. Reemplaza los valores de producción por secretos reales
#   3. NUNCA subas .env al repositorio (está en .gitignore)
#
# Para desarrollo local puedes dejar los valores por defecto.
# ============================================================

# ──────────────────────────────────────────────────────────
# General
# ──────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ──────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vigilia
POSTGRES_PASSWORD=vigilia_dev_pass
POSTGRES_DB=vigilia

# ──────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ──────────────────────────────────────────────────────────
# Backend — JWT
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
# ──────────────────────────────────────────────────────────
SECRET_KEY=CAMBIA_ESTO_EN_PRODUCCION_usa_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────────────────
# Backend — URLs de servicios
# ──────────────────────────────────────────────────────────
INFERENCE_SERVICE_URL=http://localhost:8001
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ──────────────────────────────────────────────────────────
# Inference Pipeline
# ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=

# Modelo YOLO: yolo11n.pt (nano-dev), yolo11s.pt, yolo11m.pt, yolo11l.pt (prod)
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45

# Device: cpu | cuda | cuda:0
DEVICE=cpu

# FPS objetivo del pipeline de inferencia
TARGET_FPS=10
FRAME_SKIP=3

# Tiempo de espera antes de reintentar reconexión RTSP
RTSP_RECONNECT_DELAY_SECONDS=5

# ──────────────────────────────────────────────────────────
# LLM (Fase 6 — opcional por ahora)
# ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
