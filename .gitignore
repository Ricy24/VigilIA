# ============================================================
# VigilIA — .gitignore
# ============================================================

# ──── Python ────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.egg-link
.installed.cfg
lib/
lib64/
*.pyc

# ──── Virtual Environments ────
.venv/
venv/
env/
ENV/
backend/.venv/
inference/.venv/

# ──── Variables de entorno (NUNCA subir al repositorio) ────
.env
!.env.example
docker/.env
!docker/.env.example

# ──── IDEs ────
.vscode/
.idea/
*.swp
*.swo
*~

# ──── Node.js ────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
frontend/dist/

# ──── Modelos de ML (demasiado grandes para Git) ────
models/*.pt
models/*.onnx
models/*.engine
!models/.gitkeep

# ──── Datasets ────
datasets/images/
datasets/labels/
datasets/*.zip
!datasets/.gitkeep

# ──── Logs ────
*.log
logs/

# ──── Docker ────
docker/postgres-data/
docker/redis-data/

# ──── Test / Coverage ────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover
.hypothesis/

# ──── OS ────
.DS_Store
Thumbs.db
desktop.ini

# ──── Jupyter ────
.ipynb_checkpoints/

# ──── Temporales ────
tmp/
temp/
*.tmp
docs/sad_extracted.txt
